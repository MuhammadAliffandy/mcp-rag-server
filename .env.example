# =============================================================================
# PineBioML Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# -----------------------------------------------------------------------------
# REQUIRED: OpenAI API Key
# Used by: RAG Engine, Orchestrator, Guard RAG synthesis, EXPRAG
# Get yours at: https://platform.openai.com/api-keys
# -----------------------------------------------------------------------------
OPENAI_API_KEY="sk-your-openai-api-key-here"

# -----------------------------------------------------------------------------
# OPTIONAL: Pinecone (for EXPRAG Experience-Based RAG)
# Only needed if using the EXPRAG pipeline for patient similarity search.
# Get yours at: https://www.pinecone.io/
# If not provided, EXPRAG will fall back to the EHR Database (SQLite).
# -----------------------------------------------------------------------------
# PINECONE_API_KEY="your-pinecone-api-key-here"
# PINECONE_ENV="us-west1-gcp"

# -----------------------------------------------------------------------------
# OPTIONAL: Local LLM Fallback (Plan B)
# Set LLM_PROVIDER to 'ollama' to use a local model when OpenAI quote is exhausted.
# -----------------------------------------------------------------------------
# LLM_PROVIDER="openai" # Options: openai, ollama
# OLLAMA_MODEL="llama3.1:8b" # Tested with llama3.1
# OLLAMA_BASE_URL="http://127.0.0.1:11434/v1"
